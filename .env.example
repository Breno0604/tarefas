# Conexão com o Supabase — obtidas no painel (Connect → React).
#   VITE_SUPABASE_URL = Project URL (ex.: https://xxxx.supabase.co)
#   VITE_SUPABASE_PUBLISHABLE_KEY = Publishable key (sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Domínio do login por usuário (sem digitar e-mail).
# A tela de login pede apenas "Usuário" e "Senha"; o app converte
# <usuario>@<dominio> para o Supabase Auth.
# Deve bater com o e-mail cadastrado no painel (ex.: cadastro minha.tarefa@gmail.com
# ⇒ usuário "minha.tarefa" e VITE_APP_LOGIN_DOMAIN=gmail.com).
VITE_APP_LOGIN_DOMAIN=gmail.com
